---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'notes'>>>[number];
}
const { entry } = Astro.props;
const { data } = entry;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const readingTime = (text: string) => {
  const words = text.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 220));
};
const minutes = readingTime((entry.body || '') + ' ' + (data.description || ''));
---
<Layout
  pageClass="post"
  title={`${data.title} — Ayo Omole`}
  postTitle={data.title}
  description={data.description}
  canonicalUrl={data.canonicalUrl}
>
  <article class="np">
    <header class="np-head">
      <p class="np-meta">
        <time datetime={data.pubDate.toISOString()}>{fmtDate(data.pubDate)}</time>
        <span class="np-sep" aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="np-title">{data.title}</h1>
      {data.description && <p class="np-sub">{data.description}</p>}
    </header>

    {data.cover && (
      <figure class="np-cover">
        <Image src={data.cover} alt="" loading="eager" />
      </figure>
    )}

    <div class="np-body">
      <slot />
    </div>
  </article>

  <style>
    .np {
      max-width: 50%;
      margin: 0;
      padding: clamp(2rem, 4vw, 3rem) var(--site-edge) clamp(3rem, 6vw, 5rem);
      box-sizing: border-box;
      color: var(--foreground-color);
    }

    /* Head */
    .np-head {
      margin-bottom: clamp(2rem, 4vw, 3rem);
    }
    .np-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--sansFont);
      font-size: var(--text-small);
      color: rgba(var(--foreground-color-rgb), 0.55);
      margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    }
    .np-sep { opacity: 0.45; }
    .np-title {
      font-family: var(--titleFont);
      font-size: var(--text-h1);
      line-height: 1.05;
      letter-spacing: -0.035em;
      font-weight: 400;
      color: var(--foreground-color);
      margin: 0 0 clamp(1rem, 2vw, 1.25rem);
    }
    .np-sub {
      font-family: var(--titleFont);
      font-size: var(--text-h5);
      line-height: 1.3;
      letter-spacing: -0.005em;
      font-weight: 400;
      color: rgba(var(--foreground-color-rgb), 0.7);
      margin: 0 0 clamp(1.25rem, 2vw, 1.5rem);
    }
    /* Cover */
    .np-cover {
      margin: 0 0 clamp(2rem, 4vw, 3rem);
    }
    .np-cover img {
      width: 100%;
      height: auto;
      border-radius: clamp(0.5rem, 1vw, 1rem);
      display: block;
    }

    /* Body — Substack-style long-form prose */
    .np-body {
      font-family: var(--sansFont);
      font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
      line-height: 1.65;
      color: rgba(var(--foreground-color-rgb), 0.85);
    }
    .np-body :global(p) { margin: 0 0 1.4em; }
    .np-body :global(p:last-child) { margin-bottom: 0; }
    .np-body :global(h2) {
      font-family: var(--titleFont);
      font-size: var(--text-h4);
      line-height: 1.15;
      letter-spacing: -0.02em;
      font-weight: 400;
      color: var(--foreground-color);
      margin: clamp(2.5rem, 4vw, 3rem) 0 clamp(0.75rem, 1.5vw, 1.25rem);
    }
    .np-body :global(h3) {
      font-family: var(--titleFont);
      font-size: var(--text-h5);
      line-height: 1.2;
      letter-spacing: -0.015em;
      font-weight: 500;
      color: var(--foreground-color);
      margin: clamp(2rem, 3vw, 2.5rem) 0 clamp(0.5rem, 1vw, 1rem);
    }
    .np-body :global(a) {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid currentColor;
    }
    .np-body :global(a:hover) { opacity: 0.7; }
    .np-body :global(blockquote) {
      font-family: var(--titleFont);
      font-size: clamp(1.25rem, 2vw, 1.5rem);
      line-height: 1.35;
      font-weight: 400;
      color: var(--foreground-color);
      margin: clamp(2rem, 3vw, 2.5rem) 0;
      padding-left: 1rem;
      border-left: 2px solid var(--accent);
    }
    .np-body :global(ul),
    .np-body :global(ol) {
      margin: 0 0 1.4em;
      padding-left: 1.5em;
    }
    .np-body :global(li) { margin-bottom: 0.5em; }
    .np-body :global(hr) {
      border: 0;
      height: 1px;
      background: rgba(var(--foreground-color-rgb), 0.18);
      margin: clamp(2rem, 4vw, 3rem) auto;
      width: 30%;
    }
    .np-body :global(img) {
      width: 100%;
      height: auto;
      border-radius: clamp(0.5rem, 1vw, 1rem);
      margin: clamp(1.5rem, 3vw, 2.5rem) 0;
    }
    .np-body :global(code) {
      font-family: var(--monoFont);
      font-size: 0.92em;
      padding: 0.1em 0.35em;
      border-radius: 0.25em;
      background: rgba(var(--foreground-color-rgb), 0.08);
    }
    .np-body :global(pre) {
      font-family: var(--monoFont);
      font-size: 0.9em;
      line-height: 1.5;
      padding: 1.25rem;
      border-radius: 0.75rem;
      background: rgba(var(--foreground-color-rgb), 0.06);
      overflow-x: auto;
      margin: 0 0 1.5em;
    }
    .np-body :global(pre code) {
      padding: 0;
      background: transparent;
    }

  </style>
</Layout>
