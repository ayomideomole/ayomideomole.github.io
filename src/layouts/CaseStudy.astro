---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'work'>>>[number];
}
const { entry } = Astro.props;
const { data } = entry;

const meta: string[] = [data.company, String(data.year), data.role];
if (data.duration) meta.push(data.duration);

const gallery = data.gallery ?? [];
const rawCat = data.category ?? data.tags[0];
const category = rawCat ? rawCat.charAt(0).toUpperCase() + rawCat.slice(1) : null;
---
<Layout
  pageClass="workpage"
  title={`${data.title} — Ayo Omole`}
  postTitle={data.title}
  backLabel="Work"
  backHref="/"
  description={data.summary}
  palette={data.palette}
>
  <article class="cs">
    <div class="cs-grid">
      <header class="cs-text">
        <p class="cs-meta">{meta.join(' · ')}</p>
        <h1 class="cs-title">{data.title}</h1>
        {category && <span class="cs-tag">{category}</span>}
        {data.summary && <p class="cs-summary">{data.summary}</p>}
        <div class="cs-body">
          <slot />
        </div>
      </header>

      <aside class="cs-media" aria-label="Project imagery">
        {gallery.length > 0 ? (
          gallery.map((img, i) => (
            <figure class="cs-media-tile">
              <Image src={img} alt="" loading={i < 2 ? 'eager' : 'lazy'} />
            </figure>
          ))
        ) : (
          <>
            <div class="cs-media-placeholder cs-media-placeholder--1" aria-hidden="true"></div>
            <div class="cs-media-placeholder cs-media-placeholder--2" aria-hidden="true"></div>
            <div class="cs-media-placeholder cs-media-placeholder--3" aria-hidden="true"></div>
          </>
        )}
      </aside>
    </div>

  </article>

</Layout>
